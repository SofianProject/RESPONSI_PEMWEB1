# Nonaktifkan directory listing pada folder uploads
Options -Indexes

# Tolak akses langsung ke file script atau file konfigurasi
# (Kompatibel dengan Apache di XAMPP dan shared hosting seperti InfinityFree)
<FilesMatch "\.(?i:php|phtml|php[0-9]|phar|cgi|pl|py|asp|aspx|jsp|sh|bat|exe|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
