# Nonaktifkan directory listing
Options -Indexes

# Lindungi file sensitif agar tidak bisa diakses langsung dari browser
<FilesMatch "(?i)^(\.env.*|\.git.*|config\.(local|production|production\.example)\.php)$|\.(?i:sql|md|log|bak|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
